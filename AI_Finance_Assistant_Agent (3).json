          }
        ]
      ]
    },
    "Chat Memory": {
      "ai_memory": [
        [
          {
            "node": "Finance AI Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "Log Transaction (Sheets Tool)": {
      "ai_tool": [
        [
          {
            "node": "Finance AI Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "Read Transactions (Sheets Tool)": {
      "ai_tool": [
        [
          {
            "node": "Finance AI Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "Send Finance Report (Gmail Tool)": {
      "ai_tool": [
        [
          {
            "node": "Finance AI Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "Finance AI Agent": {
      "main": [
        [
          {
            "node": "Respond to Chat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
